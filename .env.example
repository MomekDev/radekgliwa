# Skopiuj ten plik jako .env i uzupełnij.

# Klucz API Anthropic (https://console.anthropic.com). Bez niego kreator działa w TRYBIE DEMO.
ANTHROPIC_API_KEY=

# Port kreatora. Strony użytkowników działają domyślnie na PORT+1.
PORT=3000

# Model AI i „wysiłek” (low / medium / high). Wyższy = lepsze strony, ale wolniej i drożej.
MODEL=claude-opus-5-5
EFFORT=medium

# Gdzie zapisywać bazę danych.
DATA_DIR=./data

# Publiczny adres kreatora (ważne na serwerze, np. https://kreator.mojadomena.pl)
# PUBLIC_URL=

# --- Strony użytkowników (wybierz JEDEN wariant) ---
# A) domyślnie: osobny port (PORT+1) – dobre lokalnie
# SITES_PORT=3001
# B) osobna domena dla wszystkich stron:
# SITES_HOST=sites.mojadomena.pl
# C) NAJBEZPIECZNIEJSZE: każda strona na własnej subdomenie (wymaga rekordu DNS *.sites.mojadomena.pl)
# SITES_HOST=sites.mojadomena.pl
# SITES_WILDCARD=1
# D) jedna domena (najprostszy hosting, ale strony nie mają localStorage, a logowanie w aplikacjach nie przetrwa odświeżenia)
# SITES_MODE=same

# Rejestracja nowych kont (0 = wyłączona, np. gdy kreator jest tylko dla Ciebie)
# ALLOW_SIGNUP=1

# Limit wiadomości do AI na użytkownika na godzinę
# AI_RATE_LIMIT=30

# Proxy: 1 = ufaj nagłówkom X-Forwarded-* (np. Render, Railway, Cloudflare)
# TRUST_PROXY=1

# Limity: projekty na użytkownika, rekordy i rozmiar danych jednej aplikacji
# MAX_PROJECTS=100
# APP_MAX_RECORDS=20000
# APP_MAX_BYTES=52428800

# --- Produkcja z Dockerem i Caddy (HTTPS) ---
# Domena panelu kreatora (rekord A na IP serwera)
# KREATOR_DOMAIN=kreator.mojadomena.pl
# PUBLIC_URL=https://kreator.mojadomena.pl
# SITES_HOST=sites.mojadomena.pl
# SITES_WILDCARD=1
# SITES_PROTOCOL=https

# --- Własne domeny klientów ---
# Adres IP serwera – klienci ustawiają rekord A swojej domeny na ten adres
# DOMAIN_IP=203.0.113.10
# (opcjonalnie) cel rekordu CNAME dla subdomen klientów, np. sites.mojadomena.pl
# DOMAIN_CNAME_TARGET=sites.mojadomena.pl

# --- Płatności ---
# Klucz do szyfrowania sekretów projektów (np. kluczy Stripe). Ustaw długi losowy ciąg i NIE zmieniaj go później.
# SECRET_KEY=
